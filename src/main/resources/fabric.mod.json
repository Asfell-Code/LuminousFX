{
	"schemaVersion": 1,
	"id": "luminousfx",
	"version": "${version}",
	"name": "LuminousFX",
	"description": "A client-side PvP utility mod with a crystal PvP overlay, configurable visual effects, and a click GUI for managing combat-focused HUD and visual modules.",
	"authors": [
		"Asfell-Code"
	],
	"contact": {
		"homepage": "https://github.com/Asfell-Code/OneTap-Craft-Drag-Shot",
		"sources": "https://github.com/Asfell-Code/OneTap-Craft-Drag-Shot"
	},
	"license": "CC0-1.0",
	"icon": "assets/luminousfx/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"asfell.luminousfx.LuminousFX"
		],
		"client": [
			"asfell.luminousfx.client.LuminousFXClient"
		],
		"fabric-datagen": [
			"asfell.luminousfx.client.LuminousFXDataGenerator"
		]
	},
	"mixins": [
		"luminousfx.mixins.json",
		{
			"config": "luminousfx.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	}
}